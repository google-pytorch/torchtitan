# Use the latest Ray master as base.
FROM rayproject/ray:nightly.260501.1c7c90-py312-tpu

RUN sudo apt-get update && sudo apt-get install -y build-essential g++ libopenblas-base libopenmpi-dev libomp-dev
RUN pip uninstall -y torch torchvision

RUN pip install keyrings.google-artifactregistry-auth
RUN pip install pandas==2.3.3

# Set PIP_EXTRA_INDEX_URL to point to the public Torch TPU virtual registry
ENV PIP_EXTRA_INDEX_URL="https://us-python.pkg.dev/ml-oss-artifacts-published/torch-tpu-virtual-registry/simple/"

# --- Add torchtitan setup from Dockerfile ---
USER root
WORKDIR /

RUN pip install "jax[tpu]==0.9.1" -f https://storage.googleapis.com/jax-releases/libtpu_releases.html
RUN pip install git+https://github.com/openxla/tokamax.git@8cba6a6a1e52e9efbb7ff8facb66f18f0bfcbe4c
RUN pip install torch==2.12.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install libtpu==0.0.42.1 -f https://storage.googleapis.com/jax-releases/libtpu_releases.html

RUN pip install --pre --no-deps --extra-index-url "https://us-python.pkg.dev/ml-oss-artifacts-published/torch-tpu-virtual-registry/simple/" torch_tpu

COPY requirements.txt .
RUN pip install -r requirements.txt
# COPY torchtitan/.ci/docker/requirements-flux.txt .
# RUN pip install -r requirements-flux.txt

RUN pip install 'typeguard>=4.0.0'

RUN pip install portpicker absl-py numpy gcsfs frozendict triton fairscale pygtrie "git+https://github.com/PrimeIntellect-ai/renderers.git@main"

# --- Install vllm and vllm-torchtpu ---
ARG GITHUB_USER
ARG GITHUB_TOKEN
RUN git clone --depth 1 --branch v0.26.1rc0 https://github.com/vllm-project/vllm.git
RUN git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/vllm-project/vllm-torchtpu.git /vllm-torchtpu

WORKDIR /vllm-torchtpu
RUN git checkout a2c70a66a44e6dfbf1f5d89aafc1d9c686da4d03
WORKDIR /

# Patch vLLM's TPU requirements to accept our local workspace in vllm-torchtpu instead of overriding it
RUN sed -i '/vllm-torchtpu/d' vllm/requirements/tpu.txt

# Install vLLM in editable mode (forcing the 0.26.1rc0 base version to prevent .dev prerelease mismatch during dependency resolution)
WORKDIR /vllm-torchtpu

# Hack pyproject.toml to pin versions (allow latest nightly for torch-tpu)
RUN sed -i 's/torch-tpu==[0-9a-zA-Z.]*/torch-tpu/' pyproject.toml
RUN sed -i 's/libtpu==[0-9a-zA-Z.]*/libtpu==0.0.42.1/' pyproject.toml
RUN sed -i '/vllm @/d' pyproject.toml

RUN pip install --upgrade pip setuptools-rust setuptools-scm ninja cmake && SETUPTOOLS_SCM_PRETEND_VERSION=0.26.1rc0 VLLM_TARGET_DEVICE="tpu" pip install --no-build-isolation -e ../vllm
RUN SETUPTOOLS_SCM_PRETEND_VERSION=0.26.1rc0 VLLM_TARGET_DEVICE="tpu" pip install --no-build-isolation --no-deps -e .

# Reinstall the correct torch 2.12 nightly build and remove incompatible torchvision installed during vLLM resolution
RUN pip install torch==2.12.0 --index-url https://download.pytorch.org/whl/cpu && pip uninstall -y torchvision
RUN pip install torchmonarch pyre_extensions clusterscope flask tabulate && pip install --no-deps "git+https://github.com/meta-pytorch/torchstore.git@main"

WORKDIR /app
COPY torchtitan ./torchtitan
# Add dummy_modules, /app and /app/torchtitan to PYTHONPATH so that both
# standard package style (import torchtitan.*) and standalone module style
# (import experiments.*) imports work seamlessly on both head and worker nodes.
ENV PYTHONPATH="/app/torchtitan/experiments/tpu/rl_nc_ray/dummy_modules:${PYTHONPATH}:/app:/app/torchtitan"


